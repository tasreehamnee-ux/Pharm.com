{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "start": "node artifacts/api-server/dist/index.mjs",
    "build": "pnpm --filter @workspace/pharmacy run build && node -e \"require('fs').cpSync('artifacts/pharmacy/dist/public', 'dist', {recursive: true})\"",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.4",
    "typescript": "~5.9.3"
  }
}
